<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="galley_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="galley_secure.xml" />
    </device-transfer>
</data-extraction-rules>
