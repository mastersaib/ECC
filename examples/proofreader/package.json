{
  "name": "galley-proofreader",
  "version": "1.0.0",
  "private": true,
  "description": "Dialect-aware manuscript proofreader: 15 English dialects, CMOS, AP, APA, MLA, New Hart's Rules and a house style, with an optional Claude pass that protects the author's voice.",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:artifact": "node build-artifact.js dist/galley.html",
    "test": "node ../../tests/examples/proofreader-engine.test.js && node ../../tests/examples/proofreader-platform.test.js && node ../../tests/examples/proofreader-mobile.test.js",
    "android:sync": "node scripts/build-mobile.js && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && node scripts/gradle.js assembleDebug",
    "build:mobile": "node scripts/build-mobile.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "esbuild": "0.28.2"
  }
}
